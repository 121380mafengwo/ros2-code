#!/usr/bin/env python3
import rclpy
from rclpy.node import Node
from geometry_msgs.msg import Twist
from std_msgs.msg import Float64MultiArray

class DiffDriveController(Node):
    def __init__(self):
        super().__init__('diff_drive_controller')
        # 订阅 /cmd_vel
        self.subscription = self.create_subscription(Twist, '/cmd_vel', self.cmd_vel_callback, 10)
        # 发布到 /velocity_controller/commands (ros2_control 的标准接口)
        self.publisher = self.create_publisher(Float64MultiArray, '/velocity_controller/commands', 10)
        
        # 变体9 参数
        self.wheel_radius = 0.12  # m
        self.wheel_separation = 0.17 # m (前面xacro里设置的轮距)
        
        self.get_logger().info('差速驱动控制节点已启动！')

    def cmd_vel_callback(self, msg):
        v = msg.linear.x
        w = msg.angular.z
        
        # 运动学逆解
        v_left = v - (w * self.wheel_separation / 2.0)
        v_right = v + (w * self.wheel_separation / 2.0)
        
        # 转换为轮子角速度 w = v / r
        w_left = v_left / self.wheel_radius
        w_right = v_right / self.wheel_radius
        
        # 构造 Float64MultiArray 消息
        command_msg = Float64MultiArray()
        # 注意：控制器通常按 [左轮, 右轮] 的顺序接收数据
        command_msg.data = [w_left, w_right]
        
        self.publisher.publish(command_msg)
        self.get_logger().info(f'发送速度: 左轮={w_left:.2f}, 右轮={w_right:.2f}')

def main(args=None):
    rclpy.init(args=args)
    node = DiffDriveController()
    rclpy.spin(node)
    node.destroy_node()
    rclpy.shutdown()

if __name__ == '__main__':
    main()
