grep -A 2 "name=\"arm_link1\"" ~/your_ros2_ws/src/my_best_model/urdf/robot_model.xacro

source /opt/ros/jazzy/setup.bash
source ~/your_ros2_ws/install/setup.bash
ros2 run robot_state_publisher robot_state_publisher --ros-args -p robot_description:="$(xacro ~/your_ros2_ws/src/my_best_model/urdf/robot_model.xacro)"

source /opt/ros/jazzy/setup.bash
source ~/your_ros2_ws/install/setup.bash
export LIBGL_ALWAYS_SOFTWARE=1
ros2 run joint_state_publisher_gui joint_state_publisher_gui &
rviz2



<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="my_best_model">

    <xacro:include filename="materials.xacro"/>
    <xacro:include filename="wheel.xacro"/>

    <!-- 移动底盘 -->
    <link name="base_link">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry><box size="0.22 0.16 0.09"/></geometry>
            <material name="blue"/>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry><box size="0.22 0.16 0.09"/></geometry>
        </collision>
    </link>

    <!-- 驱动轮与万向轮 -->
    <xacro:wheel side="left" x="0.0" y="0.10" z="-0.045"/>
    <xacro:wheel side="right" x="0.0" y="-0.10" z="-0.045"/>

    <link name="caster_link">
        <visual>
            <geometry><sphere radius="0.03"/></geometry>
            <material name="grey"/>
        </visual>
    </link>
    <joint name="caster_joint" type="fixed">
        <parent link="base_link"/>
        <child link="caster_link"/>
        <origin xyz="-0.08 0 0.045" rpy="0 0 0"/>
    </joint>

    <!-- ================= 机械臂 ================= -->

    <!-- Link 1: 红色底座 (拉长到 0.4) -->
    <link name="arm_base_link">
        <visual>
            <geometry><cylinder length="0.4" radius="0.04"/></geometry>
            <origin xyz="0 0 0.2" rpy="0 0 0"/> <!-- 中心上移 -->
            <material name="red"/>
        </visual>
    </link>
    
    <!-- 关节 1 (R - 旋转) -->
    <joint name="joint1_R" type="revolute">
        <parent link="base_link"/>
        <child link="arm_base_link"/>
        <origin xyz="-0.05 0 0.045" rpy="0 0 0"/>
        <axis xyz="0 0 1"/>
        <limit lower="-3.14" upper="3.14" effort="10" velocity="1.0"/>
    </joint>

    <!-- Link 2: 橙色伸缩杆 (拉长到 0.6，插得极深) -->
    <link name="arm_link1">
        <visual>
            <geometry><cylinder length="0.6" radius="0.02"/></geometry>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <material name="orange"/>
        </visual>
    </link>
    
    <!-- 关节 2 (P - 滑动) -->
    <joint name="joint2_P" type="prismatic">
        <parent link="arm_base_link"/>
        <child link="arm_link1"/>
        <origin xyz="0 0 0.2" rpy="0 0 0"/> <!-- 连接点设在红管中上部 -->
        <axis xyz="0 0 1"/>
        <limit lower="0.0" upper="0.15" effort="10" velocity="0.5"/> <!-- 最大伸出0.15 -->
    </joint>

    <!-- Link 3 -->
    <link name="arm_link2">
        <visual>
            <geometry><cylinder length="0.12" radius="0.015"/></geometry>
            <origin xyz="0 0 0.06" rpy="0 0 0"/>
            <material name="green"/>
        </visual>
    </link>
    <!-- 关节 3 (R - 旋转) -->
    <joint name="joint3_R" type="revolute">
        <parent link="arm_link1"/>
        <child link="arm_link2"/>
        <!-- 因为橙杆变长，连接点设在橙杆顶端 -->
        <origin xyz="0 0 0.25" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
        <limit lower="-1.57" upper="1.57" effort="10" velocity="1.0"/>
    </joint>

    <!-- Link 4 -->
    <link name="arm_link3">
        <visual>
            <geometry><cylinder length="0.08" radius="0.01"/></geometry>
            <origin xyz="0 0 0.04" rpy="0 0 0"/>
            <material name="grey"/>
        </visual>
    </link>
    <!-- 关节 4 (C - 连续旋转) -->
    <joint name="joint4_C" type="continuous">
        <parent link="arm_link2"/>
        <child link="arm_link3"/>
        <origin xyz="0 0 0.12" rpy="0 0 0"/>
        <axis xyz="0 0 1"/>
    </joint>

    <!-- 凑数固定连杆 (Link 5 - 9) -->
    <link name="arm_link4"><visual><geometry><cylinder length="0.03" radius="0.01"/></geometry><origin xyz="0 0 0.015"/><material name="blue"/></visual></link>
    <joint name="joint5_fixed" type="fixed"><parent link="arm_link3"/><child link="arm_link4"/><origin xyz="0 0 0.08"/></joint>

    <link name="arm_link5"><visual><geometry><cylinder length="0.03" radius="0.01"/></geometry><origin xyz="0 0 0.015"/><material name="orange"/></visual></link>
    <joint name="joint6_fixed" type="fixed"><parent link="arm_link4"/><child link="arm_link5"/><origin xyz="0 0 0.03"/></joint>

    <link name="arm_link6"><visual><geometry><cylinder length="0.03" radius="0.01"/></geometry><origin xyz="0 0 0.015"/><material name="green"/></visual></link>
    <joint name="joint7_fixed" type="fixed"><parent link="arm_link5"/><child link="arm_link6"/><origin xyz="0 0 0.03"/></joint>

    <link name="arm_link7"><visual><geometry><cylinder length="0.03" radius="0.01"/></geometry><origin xyz="0 0 0.015"/><material name="red"/></visual></link>
    <joint name="joint8_fixed" type="fixed"><parent link="arm_link6"/><child link="arm_link7"/><origin xyz="0 0 0.03"/></joint>

    <link name="arm_link8"><visual><geometry><sphere radius="0.015"/></geometry><material name="red"/></visual></link>
    <joint name="joint9_fixed" type="fixed"><parent link="arm_link7"/><child link="arm_link8"/><origin xyz="0 0 0.03"/></joint>

</robot>
