#!/usr/bin/env python3
import rclpy
from rclpy.node import Node
from geometry_msgs.msg import Twist
from std_msgs.msg import Float64MultiArray

class DiffDriveController(Node):
    def __init__(self):
        super().__init__('diff_drive_controller')
        
        # 1. 订阅 /cmd_vel (接收移动指令)
        self.subscription = self.create_subscription(
            Twist, 
            '/cmd_vel', 
            self.cmd_vel_callback, 
            10
        )
        
        # 2. 发布到 /velocity_controller/commands (发送轮子角速度)
        self.publisher = self.create_publisher(
            Float64MultiArray, 
            '/velocity_controller/commands', 
            10
        )
        
        # --- 变体9的系统参数 ---
        self.wheel_radius = 0.12      # 轮子半径 0.12m
        self.wheel_separation = 0.17  # 轮距 0.17m (根据你的底盘宽度0.16m+轮子厚度推算)
        
        self.get_logger().info('差速驱动控制节点已启动！等待 /cmd_vel 指令...')

    def cmd_vel_callback(self, msg):
        # 获取目标线速度(v)和角速度(w)
        v = msg.linear.x
        w = msg.angular.z
        
        # 差速运动学逆解：计算左右轮的线速度
        v_left = v - (w * self.wheel_separation / 2.0)
        v_right = v + (w * self.wheel_separation / 2.0)
        
        # 将线速度转换为角速度 (w = v / r)
        w_left = v_left / self.wheel_radius
        w_right = v_right / self.wheel_radius
        
        # 构造要发送给控制器的消息
        command_msg = Float64MultiArray()
        # ros2_control 的 velocity_controller 通常接收一个浮点数组 [左轮速度, 右轮速度]
        command_msg.data = [w_left, w_right]
        
        # 发布消息
        self.publisher.publish(command_msg)
        self.get_logger().info(f'收到指令: 线速度={v:.2f}, 角速度={w:.2f} | 发送: 左轮={w_left:.2f} rad/s, 右轮={w_right:.2f} rad/s')

def main(args=None):
    rclpy.init(args=args)
    node = DiffDriveController()
    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        node.destroy_node()
        rclpy.shutdown()

if __name__ == '__main__':
    main()
